# Copy to .env and fill in. Never commit the real .env.

# Signs the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-character-string

# The two people who can use the app. IDs are fixed (user1 / user2),
# only the display name and passcode are configurable.
# Passcodes must be at least 6 characters.
MEOW_USER1_NAME=Person 1
MEOW_USER1_PASSCODE=change-me-1

MEOW_USER2_NAME=Person 2
MEOW_USER2_PASSCODE=change-me-2

# Cookies are marked Secure in production. Only set this to false if you
# really are serving over plain HTTP (not recommended - camera/mic need HTTPS).
# MEOW_COOKIE_SECURE=false
